/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'sha256-CLSYaRLv90glqwrD3HKrIDiyYH0kLr8ukITRDQgy8Os='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; frame-src 'none'; upgrade-insecure-requests
