/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate
/script.js
  Cache-Control: public, max-age=3600, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
/llms.txt
  Cache-Control: public, max-age=3600, must-revalidate
/assets/*
  Cache-Control: public, max-age=604800
